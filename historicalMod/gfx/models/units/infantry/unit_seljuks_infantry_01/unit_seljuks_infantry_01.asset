pdxmesh = {
	name = "unit_seljuks_infantry_01_mesh"
	file = "unit_seljuks_infantry_01.mesh"
	scale = 0.06

	lod_percentages = {
		lod = { index = 1 percent = 7.0 }
		lod = { index = 2 percent = 4.0 }
	}

	cull_distance = 3000
	# Base animations
	animation = { id = "idle_base_animation" 				type = "../animations/infantry_01_grazing_horse.anim" }
