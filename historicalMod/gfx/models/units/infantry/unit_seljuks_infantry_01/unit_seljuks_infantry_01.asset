	animation = { id = "despawn_animation" 					type = "../animations/infantry_01_dismount_horse.anim" }
	animation = { id = "gathering_army_animation" 			type = "../animations/infantry_01_gather_horse.anim" }
	animation = { id = "moving_standard_animation" 			type = "../animations/infantry_01_moving_horse.anim" }
	animation = { id = "moving_battle_animation" 			type = "../animations/infantry_01_weapon_moving_horse.anim" }
	animation = { id = "moving_retreat_animation" 			type = "../animations/infantry_01_retreat_horse.anim" }
	animation = { id = "victorious_combat_animation" 		type = "../animations/infantry_01_fight_won_rearing_horse.anim" }
	animation = { id = "victorious_siege_animation" 		type = "../animations/infantry_01_fight_won_rearing_horse.anim" }
	animation = { id = "infantry_male_sick_moving" 			type = "../animations/infantry_01_sick_moving_horse.anim" }
	animation = { id = "infantry_male_sick_idle" 			type = "../animations/infantry_01_sick_idle_horse.anim" }

	animation = { id = "cheering_rearing" 					type = "../animations/infantry_01_fight_won_rearing_horse.anim" }
	animation = { id = "cheering" 							type = "../animations/infantry_01_fight_won_idle_horse.anim" }

	# Transitions
	animation = { id = "idle_tx_battle_axes_animation" 		type = "../animations/infantry_01_weapon_moving_horse.anim" }
	animation = { id = "idle_tx_battle_swords_animation" 	type = "../animations/infantry_01_idle_tx_battle_swords.anim" }

	# Combat animations
	animation = { id = "even_offensive_seq_1_animation" 		type = "../animations/infantry_01_axe_even_offensive_seq_1.anim" }
	animation = { id = "winlose_offensive_seq_1_animation" 		type = "../animations/infantry_01_axe_winlose_offensive_seq_1.anim" }
	animation = { id = "pursuit_offensive_seq_1_animation" 		type = "../animations/infantry_01_axe_pursuit_offensive_seq_1.anim" }
	animation = { id = "even_winlose_tx_offensive_1_animation" 	type = "../animations/infantry_01_axe_even_winlose_tx_offensive_1.anim" }
	animation = { id = "winlose_even_tx_offensive_1_animation" 	type = "../animations/infantry_01_axe_winlose_even_tx_offensive_1.anim" }
	animation = { id = "even_defensive_seq_1_animation" 		type = "../animations/infantry_01_axe_even_defensive_seq_1.anim" }
	animation = { id = "winlose_defensive_seq_1_animation" 		type = "../animations/infantry_01_axe_winlose_defensive_seq_1.anim" }
	animation = { id = "pursuit_defensive_seq_1_animation" 		type = "../animations/infantry_01_axe_pursuit_defensive_seq_1.anim" }
	animation = { id = "even_winlose_tx_defensive_1_animation" 	type = "../animations/infantry_01_axe_even_winlose_tx_defensive_1.anim" }
	animation = { id = "winlose_even_tx_defensive_1_animation" 	type = "../animations/infantry_01_axe_winlose_even_tx_defensive_1.anim" }

	meshsettings = {
		name = "unit_hat"
		#index = 0
		texture_diffuse = "unit_seljuks_infantry_01_head_diffuse.dds"
		texture_normal = "unit_seljuks_infantry_01_head_normal.dds"
		texture_specular = "unit_seljuks_infantry_01_head_properties.dds"
		shader = "standard_usercolor"
		shader_file = "gfx/FX/pdxmesh.shader"
	}

	meshsettings = {
		name = "unit_body"
		#index = 1
		texture_diffuse = "unit_seljuks_infantry_01_diffuse.dds"
		texture_normal = "unit_seljuks_infantry_01_normal.dds"
		texture_specular = "unit_seljuks_infantry_01_properties.dds"
		shader = "standard_usercolor"
		shader_file = "gfx/FX/pdxmesh.shader"
	}
}

