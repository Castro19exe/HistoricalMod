pdxmesh = {
	name = "unit_tribal_african_infantry_01_mesh"
	file = "unit_tribal_african_infantry_01.mesh"
	scale = 0.06

	lod_percentages = {
		lod = { index = 1 percent = 7.0 }
		lod = { index = 2 percent = 4.0 }
	}

	cull_distance = 3000
	# Base animations
	animation = { id = "idle_base_animation" 				type = "../animations/infantry_01_idle_base.anim" }
	animation = { id = "idle_var1_animation" 				type = "../animations/infantry_01_idle_var1.anim" }
	animation = { id = "besiege_animation" 					type = "../animations/infantry_01_besiege_spear.anim" }
	animation = { id = "spawn_animation" 					type = "../animations/infantry_01_spawn_spear.anim" }
	animation = { id = "despawn_animation" 					type = "../animations/infantry_01_despawn_spear.anim" }
	animation = { id = "gathering_army_animation" 			type = "../animations/infantry_01_gathering_army.anim" }
	animation = { id = "moving_standard_animation" 			type = "../animations/infantry_01_moving_standard.anim" }
	animation = { id = "moving_battle_animation" 			type = "../animations/infantry_01_moving_battle_spear.anim" }
	animation = { id = "moving_retreat_animation" 			type = "../animations/infantry_01_moving_retreat.anim" }
	animation = { id = "victorious_combat_animation" 		type = "../animations/infantry_01_victorious_combat_spear.anim" }
	animation = { id = "victorious_siege_animation" 		type = "../animations/infantry_01_victorious_siege_spear.anim" }
	animation = { id = "infantry_male_sick_moving" 			type = "../animations/infantry_male_sick_moving.anim" }
	animation = { id = "infantry_male_sick_idle" 			type = "../animations/infantry_male_sick_idle.anim" }

	# Transitions
	animation = { id = "idle_tx_battle_axes_animation" 		type = "../animations/infantry_01_idle_tx_battle_axes.anim" }
	animation = { id = "idle_tx_battle_swords_animation" 	type = "../animations/infantry_01_idle_tx_battle_swords.anim" }
	animation = { id = "idle_tx_battle_spear_animation" 	type = "../animations/infantry_01_idle_tx_battle_spear.anim" }

	# Combat animations
	animation = { id = "even_offensive_seq_1_animation" 		type = "../animations/infantry_01_spear_even_offensive_seq_1.anim" }
	animation = { id = "winlose_offensive_seq_1_animation" 		type = "../animations/infantry_01_spear_winlose_offensive_seq_1.anim" }
	animation = { id = "pursuit_offensive_seq_1_animation" 		type = "../animations/infantry_01_spear_pursuit_offensive_seq_1.anim" }
	animation = { id = "even_winlose_tx_offensive_1_animation" 	type = "../animations/infantry_01_spear_even_winlose_tx_offensive_1.anim" }
	animation = { id = "winlose_even_tx_offensive_1_animation" 	type = "../animations/infantry_01_spear_winlose_even_tx_offensive_1.anim" }
	animation = { id = "even_defensive_seq_1_animation" 		type = "../animations/infantry_01_spear_even_defensive_seq_1.anim" }
	animation = { id = "winlose_defensive_seq_1_animation" 		type = "../animations/infantry_01_spear_winlose_defensive_seq_1.anim" }
	animation = { id = "pursuit_defensive_seq_1_animation" 		type = "../animations/infantry_01_axe_pursuit_defensive_seq_1.anim" }
	animation = { id = "even_winlose_tx_defensive_1_animation" 	type = "../animations/infantry_01_spear_even_winlose_tx_defensive_1.anim" }
	animation = { id = "winlose_even_tx_defensive_1_animation" 	type = "../animations/infantry_01_spear_winlose_even_tx_defensive_1.anim" }

	meshsettings = {
		name = "jorodoxShape"
		index = 0
		#texture_diffuse = "unit_tribal_african_infantry_01_body_diffuse.dds"
		#texture_normal = "basic_unit_sub_saharan_normal.dds"
		#texture_specular = "basic_unit_sub_saharan_properties.dds"
		texture_diffuse = "basic_unit_sub_saharan_diffuse.dds"
		texture_normal = "basic_unit_sub_saharan_normal.dds"
		texture_specular = "basic_unit_sub_saharan_properties.dds"
		shader = "standard_usercolor"
		shader_file = "gfx/FX/pdxmesh.shader"
	}

	meshsettings = {
		name = "jorodoxShape"
		index = 1
		texture_diffuse = "unit_tribal_african_infantry_01_armor_diffuse.dds"
		texture_normal = "unit_tribal_african_infantry_01_armor_normal.dds"
		texture_specular = "unit_tribal_african_infantry_01_armor_properties.dds"		
		shader = "standard_usercolor"
		shader_file = "gfx/FX/pdxmesh.shader"
	}
}


entity = {
	name = "unit_tribal_african_infantry_01_entity"
	pdxmesh = "unit_tribal_african_infantry_01_mesh"

	default_state = "idle"
	state = {
		name = "idle"
		animation = "idle_base_animation"
		looping = no
		next_state = idle
		chance = 4
	#
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0}  soundparameter = {"props_wood_metal" = 2.0} sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_idle_base" }}
	}
	state = {
		name = "idle"
		animation = "idle_var1_animation"
		looping = no
		next_state = idle
		chance = 1
	#
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_moving_retreat_var1" }}
	}
	state = {
		name = "besiege"
		animation = "besiege_animation"
		start_event = { node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity" }
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_besiege" }}
	}
	state = {
		name = "spawn"
		animation = "spawn_animation"
		looping = no
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 }  soundparameter = {"props_wood_metal" = 2.0} sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_spawn" }}
	}
	state = {
		name = "defeated"
		next_state = move_retreat
		animation = "moving_retreat_animation"
		looping = no
		animation_blend_time = 0.5
		start_event = { node = root particle = "dust_trail_3" }
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_moving_retreat" }}
	}
	state = {
		name = "disband"
		animation = "despawn_animation"
		looping = no
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_disband" }}
	}
	state = {
		name = "gather"
		animation = "gathering_army_animation"
		animation_blend_time = 0.3
		time_offset = 0.73
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_gathering_army" }}
	}

	state = {
		name = "move"
		animation = "moving_standard_animation"
		animation_blend_time = 0.3
	#
		start_event = { node = root particle = "dust_trail_3" }
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_moving_standard" }}
	}
	state = {
		name = "move_attack"
		animation = "idle_tx_battle_axes_animation"
		animation_blend_time = 0.3
		looping = no
		next_state = move_attack_continue

		event = { time = 0.36 node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity" attachment_id = weapon }
		start_event = { node = root particle = "dust_trail_3" }

		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_idle_tx_battle_axes" }}
	}
	state = {
		name = "move_attack_continue"
		animation = "moving_battle_animation"
	#
		start_event = { node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity" }
		start_event = { node = root particle = "dust_trail_3" }

		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_moving_battle" }}
	}
	state = {
		name = "move_retreat"
		animation = "moving_retreat_animation"
	#
		start_event = { node = root particle = "dust_trail_3" }
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_moving_retreat" }}
	}
	state = {
		name = "combat_won"
		animation = "victorious_combat_animation"
		looping = no
		next_state = idle
		start_event = { node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity" }
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_victorious_combat" }}
	}
	state = {
		name = "siege_won"
		animation = "victorious_siege_animation"
		looping = no
		next_state = idle
		start_event = { node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity" }
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_victorious_siege" }}
	}

	state = {
		name = "idle_sick"
		animation = "infantry_male_sick_idle"
		animation_blend_time = 0.3
		start_event = { node = root particle = "disease/flies" }
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_idle_base" }}
	}

	state = {
		name = "move_sick"
		animation = "infantry_male_sick_moving"
		animation_blend_time = 0.3
		start_event = { node = root particle = "dust_trail_3" }
		start_event = { node = root particle = "disease/flies" }
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_moving_standard" }}
	}

	####
	# COMBAT ANIMATIONS
	####

	# Even combat
	state = {
		name = "even_offensive_seq_1"
		animation = "even_offensive_seq_1_animation"
		start_event = { node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity" state = even_offensive_seq_1}
		event = {
			time = 0.0
			soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 }
			soundparameter = {"props_wood_metal" = 2.0 }
			soundparameter = {"weapon_axe_mace_sword" = 0.0 }
			sound = {soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_combat_even_seq_1_offensive"}
		}
	}

	state = {
		name = "even_defensive_seq_1"
		animation = "even_defensive_seq_1_animation"
		start_event = { node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity" state = even_defensive_seq_1}
		event = {
			time = 0.0
			soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 }
			soundparameter = {"props_wood_metal" = 2.0 }
			soundparameter = {"weapon_axe_mace_sword" = 0.0 }
			sound = {soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_combat_even_seq_1_defensive"}
		}
	}

	# Win/lose combat
	state = {
		name = "winlose_offensive_seq_1"
		animation = "winlose_offensive_seq_1_animation"
		start_event = { node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity" state = winlose_offensive_seq_1}
		event = {
			time = 0.0
			soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 }
			soundparameter = {"props_wood_metal" = 2.0 }
			soundparameter = {"weapon_axe_mace_sword" = 0.0 }
			sound = {soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_combat_winlose_seq_1_offensive"}
		}
	}

	state = {
		name = "winlose_defensive_seq_1"
		animation = "winlose_defensive_seq_1_animation"
		start_event = { node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity" state = winlose_defensive_seq_1}
		event = {
			time = 0.0
			soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 }
			soundparameter = {"props_wood_metal" = 2.0 }
			sound = {soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_combat_winlose_seq_1_defensive"}
		}
	}

	# Pursuit combat
	state = {
		name = "pursuit_offensive_seq_1"
		animation = "pursuit_offensive_seq_1_animation"
		animation_blend_time = 0.2
		start_event = { node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity" state = pursuit_offensive_seq_1}
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 2.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_combat_pursuit_offensive" }}
		event = {
			time = 0.0
			soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 }
			soundparameter = {"props_wood_metal" = 2.0 }
			sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_combat_pursuit_offensive"}
		}
	}

	state = {
		name = "pursuit_defensive_seq_1"
		animation = "pursuit_defensive_seq_1_animation"
		animation_blend_time = 0.5
		start_event = { node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity" state = pursuit_defensive_seq_1}
		event = {
			time = 0.0
			soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 }
			soundparameter = {"props_wood_metal" = 2.0 }
			sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_combat_pursuit_defensive"}
		}
	}

	# Transitions
	state = {
		name = "even_winlose_tx_offensive_1"
		animation = "even_winlose_tx_offensive_1_animation"
		start_event = { node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity"}
		event = {
			time = 0.0
			soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 }
			soundparameter = {"props_wood_metal" = 2.0 }
			sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_combat_even_tx_winlose_offensive"}
		}
	}
	state = {
		name = "winlose_even_tx_offensive_1"
		animation = "winlose_even_tx_offensive_1_animation"
		start_event = { node = Right_hand_node_1 entity = "unit_african_infantry_01_spear_entity"}
		event = {
